{
  // node 侧（core / tests / tools）。小程序侧看 miniprogram/tsconfig.json 和
  // tsconfig.miniprogram.json —— 两边的全局类型不能混（node 的 setTimeout 返回
  // Timeout，小程序的返回 number）。
  //
  // 这里故意不写 "noEmit": true：typecheck 脚本自己在命令行上带了 --noEmit，
  // 而万一开发者工具捡到了这份配置，noEmit 会让它一个 .js 都产不出来。
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["miniprogram/core/**/*.ts", "tests/**/*.ts", "tools/**/*.ts"]
}
