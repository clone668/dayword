/**
 * 全局样式 + 明暗两套配色。
 *
 * 视觉走 Anthropic 那套，底色定在 #f7f1df（偏黄的暖米白），所以整套中性色都
 * 往暖里偏了 —— 深色也不是中性黑而是暖褐黑，否则两套主题看着像两个 app。
 * 强调色只有赤陶一种，发丝边框代替阴影，层级靠留白和字号建立。
 *
 * 圆角是单个变量 --r（0.3rem ≈ 4.8px ≈ 10rpx），要整体调只改这一处。
 * 只有细进度条不用它：10rpx 圆角压在 10rpx 高的条上会变成胶囊。
 * 密度按"紧凑"排：间距和字号都收了一档，但触控目标一律保 88rpx（44px）不动 ——
 * 那是可用性下限，不是留白。
 *
 * 所有颜色都走 CSS 变量：浅色定义在 .page 上，深色由根节点追加的 .dark 覆盖
 * （同一元素上的两个单类选择器，靠书写顺序决定谁赢）。为什么只能这么写，
 * 见 data/theme.ts 的文件注释 —— Skyline 既没有媒体查询也没有后代选择器。
 *
 * 其余 Skyline 约束照旧：单类选择器 + flexbox + rpx，不用 *、后代选择器、float。
 * 渲染异常时把 app.json 的 "renderer" 从 skyline 改成 webview 即可回退。
 */

.page {
  /* ---- 浅色（默认） ---- */
  --bg: #f7f1df; /* 纸面底色，用户指定 */
  --surface: #fdfaf2; /* 卡片：比底色再亮一档，不用纯白 */
  --surface-2: #ece3ca; /* 进度槽、次级填充 */
  --line: #e4dabd; /* 发丝边框 */
  --fg: #211e16; /* 正文，暖褐黑而不是纯黑 */
  --fg-2: #5c5747; /* 次要 */
  --fg-3: #736c58; /* 提示。再浅就过不了 4.5:1 了 */
  --accent: #d97757; /* 装饰性填充：进度条、楼层条 */
  --btn-bg: #ad5228; /* 按钮底比装饰色深一档，才压得住白字（5.2:1） */
  --btn-fg: #ffffff;
  --ghost-bg: #ece3ca;
  --ghost-fg: #413c2e;
  --tint: #f7e4d4; /* 提示条 */
  --tint-fg: #8a4526;
  --ok-bg: #e6ebd5; /* 偏橄榄的浅绿，比薄荷绿更贴这张暖底 */
  --ok-fg: #455230;
  --no-bg: #f7ded4;
  --no-fg: #8f3a1e;
  --warn-bg: #f5e7c4;
  --warn-fg: #6d4f14;
  --serif: Georgia, "Times New Roman", "Songti SC", serif;
  --r: 10rpx;

  /* 页面根容器：竖向 flex，顶栏定高、内容区吃掉剩余高度 */
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background-color: var(--bg);
  color: var(--fg);
  font-size: 28rpx;
}

/**
 * 深色。只覆盖变量 —— 布局属性一条都不用重复写。
 * 中性色带一点棕黄，和浅色的 #f7f1df 同源；纯灰配上赤陶会显脏。
 */
.dark {
  --bg: #1c1a15;
  --surface: #24211a;
  --surface-2: #322e24;
  --line: #3d3830;
  --fg: #f5f0e2;
  --fg-2: #b8b2a0;
  --fg-3: #8f887a;
  --accent: #e0895f; /* 深底上把赤陶提亮一档，否则装饰条看不见 */
  --btn-bg: #e0895f; /* 深色下珊瑚够亮，压深字（6.3:1）比压白字对比度高一倍 */
  --btn-fg: #201d16;
  --ghost-bg: #322e24;
  --ghost-fg: #e8e2d2;
  --tint: #3a2a1e;
  --tint-fg: #edb492;
  --ok-bg: #2b3122;
  --ok-fg: #b0c793;
  --no-bg: #3b241b;
  --no-fg: #f0a68b;
  --warn-bg: #362d18;
  --warn-fg: #dfc07f;
}

/* 唯一的滚动容器。min-height: 0 不能省，否则 flex 子项不肯收缩、页面整体被撑高 */
.body {
  flex: 1;
  min-height: 0;
}

/* ---- 顶栏 ---- */

.bar {
  padding-left: 32rpx;
  padding-right: 24rpx;
  padding-bottom: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.bar-left {
  display: flex;
  flex-direction: column;
}

.bar-title {
  font-family: var(--serif);
  font-size: 34rpx;
  color: var(--fg);
}

.bar-level {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--fg-3);
  letter-spacing: 1rpx;
}

/* 88rpx = 44px，触控目标的下限，紧凑密度也不能再小 */
.theme-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r);
  border: 1rpx solid var(--line);
  background-color: var(--surface);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.theme-btn-text {
  font-size: 32rpx;
  color: var(--fg-2);
}

/* 滚动到底时的呼吸位。紧凑密度下从 80rpx 收到 48rpx */
.tail {
  height: 48rpx;
}

/* ---- 卡片 ---- */

.card {
  margin: 14rpx 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r);
  display: flex;
  flex-direction: column;
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-family: var(--serif);
  font-size: 30rpx;
  color: var(--fg);
}

.card-sub {
  font-size: 22rpx;
  color: var(--fg-3);
}

/* 卡片里的说明段落。首页的定级入口和定级页的开场都要用 */
.para {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--fg-2);
  line-height: 38rpx;
}

/* ---- 按钮 ---- */

.cta {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: var(--r);
  background-color: var(--btn-bg);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

/* Skyline 没有 :active，按下态只能靠 hover-class */
.cta-hover {
  opacity: 0.82;
}

.cta-disabled {
  opacity: 0.55;
}

.cta-text {
  color: var(--btn-fg);
  font-size: 30rpx;
  font-weight: bold;
}

.cta-ghost {
  background-color: var(--ghost-bg);
}

.cta-ghost-text {
  color: var(--ghost-fg);
  font-size: 28rpx;
  font-weight: bold;
}

/* ---- 键值行（周报） ---- */

.kv {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
  border-top: 1rpx solid var(--line);
}

.kv-k {
  font-size: 26rpx;
  color: var(--fg-2);
}

.kv-v {
  font-size: 26rpx;
  color: var(--fg);
}

/**
 * ---- 答题界面的公共零件 ----
 *
 * 这一段原本只在 learn/index.wxss 里。定级页也要出题，而**页面 WXSS 不跨页共享**
 * （只有 app.wxss 是全局的），所以两个页面都用到的规则必须搬上来 ——
 * 否则定级页会长成一堆没有样式的裸文字，而且不报错。
 */

/* 返回。撑到 88rpx 是为了够得着（原来只有文字高度约 50rpx），
   顺带让学习/定级页的顶栏和首页那颗 88rpx 的主题按钮一样高 —— 页面间不再跳 */
.back {
  min-height: 88rpx;
  padding-right: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.back-text {
  font-size: 30rpx;
  color: var(--fg-2);
}

/* 细进度条不用 --r：10rpx 圆角压在 6rpx 高的条上会变成胶囊 */
.pbar {
  margin: 0 32rpx 10rpx 32rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background-color: var(--surface-2);
  display: flex;
  flex-direction: row;
}

.pfill {
  height: 6rpx;
  border-radius: 2rpx;
  background-color: var(--accent);
}

.loading {
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--fg-3);
}

.q-hint {
  font-size: 24rpx;
  color: var(--fg-3);
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.q-title {
  font-family: var(--serif);
  font-size: 46rpx;
  color: var(--fg);
  margin-top: 12rpx;
}

.q-sub {
  font-size: 26rpx;
  color: var(--fg-2);
  margin-top: 8rpx;
}

.q-degrade {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  background-color: var(--warn-bg);
  border-radius: var(--r);
  font-size: 22rpx;
  color: var(--warn-fg);
  line-height: 30rpx;
}

.stem-img {
  width: 100%;
  height: 260rpx;
  border-radius: var(--r);
}

/* 配图还没接入时的替身。真机上下载失败也走这条路径 */
.stem-fallback {
  height: 160rpx;
  border-radius: var(--r);
  background-color: var(--surface-2);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.stem-fallback-text {
  font-family: var(--serif);
  font-size: 38rpx;
  color: var(--fg-2);
}

.audio {
  margin-top: 16rpx;
  height: 88rpx;
  border-radius: var(--r);
  border: 1rpx solid var(--line);
  background-color: var(--ghost-bg);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.audio-text {
  font-size: 30rpx;
  color: var(--ghost-fg);
}

.opts {
  margin: 0 24rpx;
  display: flex;
  flex-direction: column;
}

/* min-height 88rpx 是硬下限，padding 可以收 */
.opt {
  margin-bottom: 12rpx;
  padding: 20rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  background-color: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 判分后覆盖底色和边框。同一元素上的第二个单类选择器，Skyline 认这种写法 */
.opt-right {
  background-color: var(--ok-bg);
  border-color: var(--ok-fg);
}

.opt-wrong {
  background-color: var(--no-bg);
  border-color: var(--no-fg);
}

/**
 * 定级页的"已选中"。刻意既不是绿也不是红 —— 那一页不告诉孩子对错
 * （见 pages/placement/index.ts 文件头第 2 条），只回应"我点到了"。
 * 和 .opt-right/.opt-wrong 放一起是为了保证书写顺序在 .opt 之后。
 */
.opt-picked {
  background-color: var(--tint);
  border-color: var(--accent);
}

.opt-img {
  width: 100%;
  height: 160rpx;
  margin-bottom: 12rpx;
}

.opt-text {
  font-size: 32rpx;
  color: var(--fg);
}

/* 提示条。首页用来说"暂停发新词"，定级页用来说"词库上限" */
.notice {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background-color: var(--tint);
  border-radius: var(--r);
}

.notice-text {
  font-size: 24rpx;
  color: var(--tint-fg);
  line-height: 34rpx;
}

.done-title {
  font-family: var(--serif);
  font-size: 38rpx;
  color: var(--fg);
  margin-bottom: 18rpx;
}
