/* 首页。配色和圆角全部走 app.wxss 的变量，深浅两套共用这一份规则。 */

.task-row {
  display: flex;
  flex-direction: row;
}

.task-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 数字用衬线体：Anthropic 那种"排版感"主要就来自这里。
   紧凑密度下从 68rpx 收到 58rpx —— 还是全页最大的字，层级不会塌 */
.task-num {
  font-family: var(--serif);
  font-size: 58rpx;
  color: var(--fg);
  line-height: 68rpx;
}

.task-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--fg-3);
  letter-spacing: 1rpx;
}

/* .notice* / .cta* / .kv* 都在 app.wxss 里 —— 三个页面共用 */

.empty {
  margin-top: 20rpx;
  align-items: center;
  display: flex;
  flex-direction: column;
}

.empty-text {
  font-size: 26rpx;
  color: var(--fg-3);
}

/* ---- 爬楼梯 ---- */

.floor {
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
}

.floor-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.floor-name {
  font-size: 26rpx;
  color: var(--fg-2);
}

.floor-count {
  font-family: var(--serif);
  font-size: 26rpx;
  color: var(--fg-3);
}

/* 这两条不用 --r：10rpx 圆角压在 10rpx 高的条上会变成胶囊，
   而且圆头条看着像游戏进度条，不是这套视觉要的东西 */
.floor-bar {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background-color: var(--surface-2);
  display: flex;
  flex-direction: row;
}

.floor-fill {
  height: 10rpx;
  border-radius: 3rpx;
  background-color: var(--accent);
}

.floor-sample {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--fg-3);
}

.floor-hint {
  margin-top: 4rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--fg-3);
  line-height: 32rpx;
}

/* ---- 连续打卡 ---- */

.streak-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.streak-flame {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.streak-info {
  display: flex;
  flex-direction: column;
}

.streak-num {
  font-family: var(--serif);
  font-size: 32rpx;
  color: var(--fg);
}

.streak-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--fg-3);
}

/* ---- 家长周报 ---- */

.stubborn {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  background-color: var(--no-bg);
  border-radius: var(--r);
  font-size: 24rpx;
  color: var(--no-fg);
  line-height: 34rpx;
}

/* ---- 开发者工具 ---- */

.card-dev {
  background-color: transparent;
  border-style: dashed;
}

.dev-note {
  font-size: 22rpx;
  color: var(--fg-3);
  line-height: 32rpx;
  margin-bottom: 14rpx;
}

.dev-row {
  display: flex;
  flex-direction: row;
}

/* 88rpx 不动：紧凑密度收的是留白，不是能不能点中 */
.dev-btn {
  flex: 1;
  margin-right: 12rpx;
  height: 88rpx;
  border-radius: var(--r);
  border: 1rpx solid var(--line);
  background-color: var(--surface);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.dev-btn-warn {
  margin-right: 0;
  background-color: var(--no-bg);
}

.dev-btn-text {
  font-size: 26rpx;
  color: var(--fg-2);
}
