/* 学习页。配色全部走 app.wxss 的变量，深浅两套共用这一份规则。 */

.back {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  padding-right: 20rpx;
}

.back-text {
  font-size: 30rpx;
  color: var(--fg-2);
}

.pbar {
  margin: 0 40rpx 12rpx 40rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--surface-2);
  display: flex;
  flex-direction: row;
}

.pfill {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--accent);
}

.loading {
  padding: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--fg-3);
}

/* ---- 题干 ---- */

.q-hint {
  font-size: 24rpx;
  color: var(--fg-3);
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
}

.q-title {
  font-family: var(--serif);
  font-size: 56rpx;
  color: var(--fg);
  margin-top: 16rpx;
}

.q-sub {
  font-size: 26rpx;
  color: var(--fg-2);
  margin-top: 12rpx;
}

.q-degrade {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background-color: var(--warn-bg);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--warn-fg);
  line-height: 32rpx;
}

.stem-img {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
}

/* 配图还没接入时的替身。真机上下载失败也走这条路径 */
.stem-fallback {
  height: 200rpx;
  border-radius: 12rpx;
  background-color: var(--surface-2);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.stem-fallback-text {
  font-family: var(--serif);
  font-size: 44rpx;
  color: var(--fg-2);
}

.audio {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
  background-color: var(--ghost-bg);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.audio-text {
  font-size: 30rpx;
  color: var(--ghost-fg);
}

/* ---- 教学卡 ---- */

/* 用 --tint-fg 而不是 --accent：22rpx 的小字压在卡片底色上，
   赤陶色原色只有 2.9:1，过不了 4.5:1 */
.teach-tag {
  font-size: 22rpx;
  color: var(--tint-fg);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.teach-word {
  margin-top: 28rpx;
  font-family: var(--serif);
  font-size: 72rpx;
  color: var(--fg);
}

.teach-zh {
  margin-top: 20rpx;
  font-size: 32rpx;
  color: var(--fg-2);
}

.teach-ex {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--fg-2);
  line-height: 42rpx;
}

.teach-ex-zh {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--fg-3);
  line-height: 36rpx;
}

/* ---- 选项 ---- */

.opts {
  margin: 0 28rpx;
  display: flex;
  flex-direction: column;
}

.opt {
  margin-bottom: 16rpx;
  padding: 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  background-color: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 判分后覆盖底色和边框。同一元素上的第二个单类选择器，Skyline 认这种写法 */
.opt-right {
  background-color: var(--ok-bg);
  border-color: var(--ok-fg);
}

.opt-wrong {
  background-color: var(--no-bg);
  border-color: var(--no-fg);
}

.opt-img {
  width: 100%;
  height: 200rpx;
  margin-bottom: 16rpx;
}

.opt-text {
  font-size: 34rpx;
  color: var(--fg);
}

/* ---- 点字母拼写 ---- */

.spell-out {
  min-height: 116rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 1rpx dashed var(--line);
  background-color: var(--bg);
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}

.spell-empty {
  font-size: 24rpx;
  color: var(--fg-3);
  padding-left: 12rpx;
}

.spell-pool {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

/* 88rpx = 44px：触控目标的下限。小孩的手指比大人还难瞄准 */
.chip {
  margin: 8rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background-color: var(--ghost-bg);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.chip-used {
  opacity: 0.3;
}

.chip-text {
  font-family: var(--serif);
  font-size: 36rpx;
  color: var(--ghost-fg);
}

/* ---- 输入 ---- */

.input {
  height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
  background-color: var(--bg);
  font-size: 36rpx;
  color: var(--fg);
}

.submit-wrap {
  margin: 0 28rpx;
}

/* ---- 反馈 ---- */

.fb {
  margin: 20rpx 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
}

/* 文字颜色写在父节点上，靠继承传给 .fb-text ——
   没有后代选择器可用，让 .fb-text 不声明 color 是唯一能按状态变色的办法 */
.fb-right {
  background-color: var(--ok-bg);
  color: var(--ok-fg);
}

.fb-wrong {
  background-color: var(--no-bg);
  color: var(--no-fg);
}

.fb-guess {
  background-color: var(--warn-bg);
  color: var(--warn-fg);
}

.fb-text {
  font-size: 30rpx;
  line-height: 44rpx;
}

/* ---- 结算 ---- */

.done-title {
  font-family: var(--serif);
  font-size: 44rpx;
  color: var(--fg);
  margin-bottom: 24rpx;
}

.levelup {
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background-color: var(--tint);
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.levelup-text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--tint-fg);
}
