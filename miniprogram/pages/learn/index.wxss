/**
 * 学习页专有样式。
 *
 * 答题界面的公共零件（.q-* / .opt* / .stem-* / .audio* / .pbar / .back / .loading*）
 * 都在 app.wxss 里 —— 定级页也要用，而页面 WXSS 不跨页共享。
 * 这里只留学习页独有的：教学卡、拼字母、输入框、判分反馈、结算。
 */

/* ---- 教学卡 ---- */

/* 用 --tint-fg 而不是 --accent：22rpx 的小字压在卡片底色上，
   赤陶色原色只有 2.9:1，过不了 4.5:1 */
.teach-tag {
  font-size: 22rpx;
  color: var(--tint-fg);
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
}

.teach-word {
  margin-top: 20rpx;
  font-family: var(--serif);
  font-size: 60rpx;
  color: var(--fg);
}

.teach-zh {
  margin-top: 14rpx;
  font-size: 32rpx;
  color: var(--fg-2);
}

.teach-ex {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--fg-2);
  line-height: 40rpx;
}

.teach-ex-zh {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--fg-3);
  line-height: 34rpx;
}

/* ---- 点字母拼写 ---- */

.spell-out {
  min-height: 104rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: var(--r);
  border: 1rpx dashed var(--line);
  background-color: var(--bg);
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}

.spell-empty {
  font-size: 24rpx;
  color: var(--fg-3);
  padding-left: 10rpx;
}

.spell-pool {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

/* 88rpx = 44px：触控目标的下限。小孩的手指比大人还难瞄准，
   所以紧凑密度只收字母块之间的间距（8rpx → 6rpx），块本身不动 */
.chip {
  margin: 6rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r);
  border: 1rpx solid var(--line);
  background-color: var(--ghost-bg);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.chip-used {
  opacity: 0.3;
}

.chip-text {
  font-family: var(--serif);
  font-size: 34rpx;
  color: var(--ghost-fg);
}

/* ---- 输入 ---- */

.input {
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--r);
  border: 1rpx solid var(--line);
  background-color: var(--bg);
  font-size: 34rpx;
  color: var(--fg);
}

.submit-wrap {
  margin: 0 24rpx;
}

/* ---- 反馈 ---- */

.fb {
  margin: 14rpx 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: var(--r);
  display: flex;
  flex-direction: column;
}

/* 文字颜色写在父节点上，靠继承传给 .fb-text ——
   没有后代选择器可用，让 .fb-text 不声明 color 是唯一能按状态变色的办法 */
.fb-right {
  background-color: var(--ok-bg);
  color: var(--ok-fg);
}

.fb-wrong {
  background-color: var(--no-bg);
  color: var(--no-fg);
}

.fb-guess {
  background-color: var(--warn-bg);
  color: var(--warn-fg);
}

.fb-text {
  font-size: 30rpx;
  line-height: 40rpx;
}

/* ---- 结算 ---- */

.levelup {
  margin-bottom: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: var(--r);
  background-color: var(--tint);
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.levelup-text {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--tint-fg);
}
